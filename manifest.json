{
  "manifest_version": 3,
  "name": "Edgenuity AI Companion",
  "description": "Study-support companion with activity detection and safe instructional navigation.",
  "version": "0.1.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.edgenuity.com/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://*.edgenuity.com/*"],
    "js": ["src/content.js"],
    "css": ["src/sidebar.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Edgenuity AI Companion" }
}
